# Copy this file to .env and fill in your values

# AI Provider — "gemini" (default, free), "claude", or "auto"
AI_PROVIDER=gemini

# Google Gemini — free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic (Claude) — optional, at https://console.anthropic.com
ANTHROPIC_API_KEY=

# JWT secret — change this to a long random string in production
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Token expiry in minutes (default: 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database path (default: ./just_wright.db)
DB_PATH=./just_wright.db

# Daily AI credit limits
FREE_DAILY_LIMIT=50
AUTH_DAILY_LIMIT=200
